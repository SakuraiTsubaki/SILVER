    {
      "name": "species_id",
      "offset": 0,
      "bytes": 2
    },
    {
      "name": "form_id",
      "offset": 2,
      "bytes": 2
    },
    {
      "name": "item_id",
      "offset": 4,
      "bytes": 2
    },
    {
      "name": "ability_id",
      "offset": 6,
      "bytes": 2
    },
    {
      "name": "move_ids",
      "offset": 8,
      "bytes": 8,
      "count": 4,
      "element_bytes": 2
    },
    {
      "name": "legacy_tail",
      "offset": 16,
      "bytes": 26
    },
    {
      "name": "source_profile",
      "offset": 42,
      "bytes": 1
    },
    {
