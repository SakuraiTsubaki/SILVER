    "legacy_tail_valid": 0,
    "migrated_from_gen2": 1
  },
  "migration_defaults": {
    "form_id": 0,
    "ability_id": 0,
    "note": "Legacy Silver does not encode modern form or ability identities; migration must not infer them."
  },
  "downgrade_rules": {
    "require_form_id_zero": true,
    "require_ability_id_zero": true,
    "require_species_item_moves_fit_u8": true,
    "restore_legacy_tail_verbatim": true
