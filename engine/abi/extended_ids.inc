; SILVER extended engine ABI
; Generation-10-ready identity widths. Content IDs are assigned later.

DEF SILVER_ABI_VERSION EQU 1
DEF SILVER_TARGET_GENERATION EQU 10

DEF ID8_NONE      EQU $00
DEF ID8_INVALID   EQU $FF
DEF ID16_NONE     EQU $0000
DEF ID16_INVALID  EQU $FFFF
DEF ID32_NONE     EQU $00000000
DEF ID32_INVALID  EQU $FFFFFFFF

DEF SPECIES_ID_BYTES    EQU 2
DEF FORM_ID_BYTES       EQU 2
DEF MOVE_ID_BYTES       EQU 2
DEF ITEM_ID_BYTES       EQU 2
DEF ABILITY_ID_BYTES    EQU 2
DEF TYPE_ID_BYTES       EQU 1
DEF GENERATION_ID_BYTES EQU 1
DEF STRING_ID_BYTES     EQU 4
DEF FEATURE_FLAGS_BYTES EQU 4

; Mapper-independent data pointer:
;   dw logical bank
;   dw offset
DEF FARPTR_BANK_BYTES   EQU 2
DEF FARPTR_OFFSET_BYTES EQU 2
DEF FARPTR_BYTES        EQU 4

; Public engine code must not collapse species + form into one legacy byte.
DEF MON_IDENTITY_BYTES EQU SPECIES_ID_BYTES + FORM_ID_BYTES
