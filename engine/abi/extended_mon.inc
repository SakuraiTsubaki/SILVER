; SILVER ExpandedMonV1 ABI
; Release provenance is exact: all eight audited retail Silver inputs have
; independent profile codes even when their save layout family is shared.

DEF LEGACY_BOXMON_BYTES EQU 32
DEF LEGACY_BOXMON_SPECIES EQU 0
DEF LEGACY_BOXMON_ITEM EQU 1
DEF LEGACY_BOXMON_MOVES EQU 2
DEF LEGACY_BOXMON_MOVE_COUNT EQU 4
DEF LEGACY_BOXMON_TAIL EQU 6
DEF LEGACY_BOXMON_TAIL_BYTES EQU 26

DEF XMON_SPECIES EQU 0
DEF XMON_FORM EQU 2
DEF XMON_ITEM EQU 4
DEF XMON_ABILITY EQU 6
DEF XMON_MOVES EQU 8
DEF XMON_MOVE1 EQU 8
DEF XMON_MOVE2 EQU 10
DEF XMON_MOVE3 EQU 12
DEF XMON_MOVE4 EQU 14
DEF XMON_LEGACY_TAIL EQU 16
DEF XMON_LEGACY_TAIL_BYTES EQU 26
DEF XMON_SOURCE_PROFILE EQU 42
DEF XMON_SOURCE_REVISION EQU 43
DEF XMON_FEATURE_FLAGS EQU 44
DEF XMON_RESERVED EQU 48
DEF XMON_RESERVED_BYTES EQU 16
DEF XMON_RECORD_BYTES EQU 64

DEF XMON_PROFILE_JP_REV0 EQU 1
DEF XMON_PROFILE_JP_REV1 EQU 2
DEF XMON_PROFILE_KO_REV0 EQU 3
DEF XMON_PROFILE_EN_REV0 EQU 4
DEF XMON_PROFILE_DE_REV0 EQU 5
DEF XMON_PROFILE_FR_REV0 EQU 6
DEF XMON_PROFILE_IT_REV0 EQU 7
DEF XMON_PROFILE_ES_REV0 EQU 8
DEF XMON_PROFILE_COUNT EQU 8

DEF XMON_FLAG_LEGACY_TAIL_VALID_F EQU 0
DEF XMON_FLAG_MIGRATED_FROM_GEN2_F EQU 1
DEF XMON_FLAG_LEGACY_TAIL_VALID EQU 1 << XMON_FLAG_LEGACY_TAIL_VALID_F
DEF XMON_FLAG_MIGRATED_FROM_GEN2 EQU 1 << XMON_FLAG_MIGRATED_FROM_GEN2_F

DEF XMON_LEGACY_DEFAULT_FORM EQU ID16_NONE
DEF XMON_LEGACY_DEFAULT_ABILITY EQU ID16_NONE

assert XMON_LEGACY_TAIL + XMON_LEGACY_TAIL_BYTES == XMON_SOURCE_PROFILE
assert XMON_FEATURE_FLAGS + FEATURE_FLAGS_BYTES == XMON_RESERVED
assert XMON_RESERVED + XMON_RESERVED_BYTES == XMON_RECORD_BYTES

MACRO expanded_mon_v1
\1Species:: ds SPECIES_ID_BYTES
\1Form:: ds FORM_ID_BYTES
\1Item:: ds ITEM_ID_BYTES
\1Ability:: ds ABILITY_ID_BYTES
\1Moves:: ds MOVE_ID_BYTES * LEGACY_BOXMON_MOVE_COUNT
\1LegacyTail:: ds XMON_LEGACY_TAIL_BYTES
\1SourceProfile:: db
\1SourceRevision:: db
\1FeatureFlags:: ds FEATURE_FLAGS_BYTES
\1Reserved:: ds XMON_RESERVED_BYTES
\1End::
ENDM
